#include <iostream>          // Для ввода-вывода
#include <string>            // Для работы со строками
using namespace std;         // Чтобы не писать std:: каждый раз

// Класс, моделирующий заказ в автосервисе
class ServiceOrder {
private:
    int orderNumber;         // Номер заказа
    string carBrand;         // Марка автомобиля
    string workDescription;  // Описание работ
    double cost;             // Текущая стоимость заказа

public:
    // Конструктор с параметрами
    ServiceOrder(int number,
                 const string &brand,
                 const string &description,
                 double startCost) {
        setOrderNumber(number);          // Устанавливаем номер
        setCarBrand(brand);             // Устанавливаем марку
        setWorkDescription(description);// Устанавливаем описание
        setCost(startCost);             // Устанавливаем начальную стоимость
    }

    // ===== ГЕТТЕРЫ =====

    int getOrderNumber() const {        // Получить номер заказа
        return orderNumber;
    }

    string getCarBrand() const {        // Получить марку автомобиля
        return carBrand;
    }

    string getWorkDescription() const { // Получить описание работ
        return workDescription;
    }

    double getCost() const {            // Получить текущую стоимость
        return cost;
    }

    // ===== СЕТТЕРЫ =====

    void setOrderNumber(int number) {   // Установить номер заказа
        if (number > 0) {
            orderNumber = number;
        } else {
            cout << "Номер заказа должен быть положительным. "
                 << "Установлено значение 0." << endl;
            orderNumber = 0;
        }
    }

    void setCarBrand(const string &brand) { // Установить марку автомобиля
        if (!brand.empty()) {
            carBrand = brand;
        } else {
            cout << "Марка автомобиля не может быть пустой. "
                 << "Установлено значение \"Не указано\"." << endl;
            carBrand = "Не указано";
        }
    }

    void setWorkDescription(const string &description) { // Установить описание
        if (!description.empty()) {
            workDescription = description;
        } else {
            workDescription = "Нет описания";
        }
    }

    void setCost(double newCost) {      // Установить стоимость
        if (newCost >= 0) {
            cost = newCost;
        } else {
            cout << "Стоимость не может быть отрицательной. "
                 << "Установлено значение 0." << endl;
            cost = 0;
        }
    }

    // Метод добавления работы к заказу (увеличение стоимости)
    void addWork(const string &newWork, double workCost) {
        if (workCost > 0) {
            if (!workDescription.empty()) {
                workDescription += "; "; // Разделяем работы точкой с запятой
            }
            workDescription += newWork;  // Добавляем текст новой работы
            cost += workCost;            // Увеличиваем общую стоимость
        } else {
            cout << "Стоимость работы должна быть положительной." << endl;
        }
    }

    // Метод применения скидки в процентах
    void applyDiscount(double percent) {
        if (percent > 0 && percent < 100) {
            double discountAmount = cost * (percent / 100.0); // Размер скидки
            cost -= discountAmount;                           // Новая стоимость
        } else {
            cout << "Скидка должна быть в диапазоне (0; 100)." << endl;
        }
    }

    // Метод вывода информации о заказе
    void printInfo() const {
        cout << "------------------------------" << endl;
        cout << "Номер заказа: " << orderNumber << endl;
        cout << "Марка автомобиля: " << carBrand << endl;
        cout << "Описание работ: " << workDescription << endl;
        cout << "Текущая стоимость: " << cost << " руб." << endl;
        cout << "------------------------------" << endl;
    }
};

int main() {
    // Создаём объект заказа через конструктор
    ServiceOrder order(101, "Toyota", "Диагностика", 2000);

    cout << "Исходный заказ:" << endl;
    order.printInfo();  // Выводим начальное состояние заказа

    // Добавляем новую работу и выводим результат
    cout << "Добавляем работу: \"Замена масла\" на 1500 руб." << endl;
    order.addWork("Замена масла", 1500);
    order.printInfo();

    // Применяем скидку и выводим результат
    cout << "Применяем скидку 10%:" << endl;
    order.applyDiscount(10);
    order.printInfo();

    // Пример работы геттеров и сеттеров с выводом
    cout << "Меняем марку и номер заказа через сеттеры..." << endl;
    order.setCarBrand("BMW");
    order.setOrderNumber(202);

    cout << "Проверяем через геттеры:" << endl;
    cout << "Новый номер заказа: " << order.getOrderNumber() << endl;
    cout << "Новая марка авто: " << order.getCarBrand() << endl;

    cout << "Итоговое состояние заказа:" << endl;
    order.printInfo();

    return 0; // Успешное завершение программы
}
